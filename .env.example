PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/less_perfums
JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=reemplaza-por-una-clave-segura

# Google Identity Services (inicio de sesión y registro)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Gmail API: OAuth de escritorio/web con permiso gmail.send y token de actualización
GOOGLE_CLIENT_SECRET=tu-client-secret
GMAIL_REFRESH_TOKEN=tu-refresh-token
GMAIL_SENDER=tienda@tudominio.com

# Cloudflare Turnstile. En desarrollo se usan llaves públicas de prueba si se omiten.
# En producción configura las llaves reales de tu sitio y del servidor.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cuenta de proveedor creada/actualizada al iniciar el servidor.
SUPPLIER_EMAIL=proveedor@tudominio.com
SUPPLIER_PASSWORD=reemplaza-por-una-clave-de-al-menos-8-caracteres
SUPPLIER_NAME=Proveedor Less Perfum

# Wompi Colombia. Empieza en sandbox; no uses llaves de producción para pruebas.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_tu-llave-publica
WOMPI_INTEGRITY_SECRET=tu-secreto-de-integridad
WOMPI_EVENTS_SECRET=tu-secreto-de-eventos
WOMPI_REDIRECT_URL=http://localhost:3000/checkout.html
